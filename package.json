{
  "name": "@luyi0825/zcode-acp",
  "version": "0.5.4",
  "description": "ACP v1 agent that bridges the ZCode CLI, so ACP clients (Zed, Neovim, OpenIdea, ...) can use ZCode as their coding agent",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/luyi0825/zcode-acp.git"
  },
  "type": "module",
  "bin": {
    "zcode-acp": "./bin/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "bin",
    "src",
    "test",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "release": "bash build/release.sh",
    "test": "node --test test/regression.test.mjs test/image.test.mjs",
    "smoke": "node test/smoke.mjs"
  },
  "keywords": [
    "acp",
    "agent-client-protocol",
    "zcode",
    "zai",
    "agent",
    "cli"
  ],
  "dependencies": {
    "@agentclientprotocol/sdk": "^2.6.0"
  }
}
